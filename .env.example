# Required for the LLM-based DietaryIntentAgent (api/_lib/agents/dietary_intent.py).
# Get a key at https://platform.openai.com/api-keys
# If this is unset, the agent falls back to a deterministic keyword/regex parser
# instead of failing the request.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini if unset. Must be a model that supports
# JSON mode (response_format: json_object).
OPENAI_MODEL=

# Optional but strongly recommended in production. Vercel KV / Upstash Redis,
# used to cache Overpass and Nominatim results (api/_lib/tools/cache.py).
#
# Both are free services with no capacity guarantee: Overpass answers a
# saturated request with a 504, a 429 or a hang, and a search issues up to four
# of them. Caching does not make the mirrors faster -- it stops the app asking
# them the same question, which is what turns an intermittently failing search
# into a reliable one.
#
# On Vercel: Storage -> create a KV / Upstash Redis store and connect it to the
# project. Both variables are injected automatically; no code change is needed.
# With them unset the cache is a no-op and the app behaves exactly as before.
KV_REST_API_URL=
KV_REST_API_TOKEN=
