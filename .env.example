# Required for the LLM-based DietaryIntentAgent (src/agents/dietary-intent-agent.ts).
# Get a key at https://platform.openai.com/api-keys
# If this is unset, the agent falls back to a deterministic keyword/regex parser
# instead of failing the request.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini if unset. Must be a model that supports
# JSON mode (response_format: json_object).
OPENAI_MODEL=
